@'
# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Environment variables and secrets
.env
.env.*
!.env.example

# Data files
data/raw/*
!data/raw/.gitkeep
data/generated/*
!data/generated/.gitkeep

# dbt
dbt/target/
dbt/logs/
dbt/dbt_packages/

# Airflow
airflow/logs/

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
'@ | Set-Content -Encoding utf8 .gitignore