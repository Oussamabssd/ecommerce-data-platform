# ==============================================================================
# Operational PostgreSQL Configuration
# ==============================================================================
POSTGRES_DB=ecommerce_operational
POSTGRES_USER=ecommerce_admin
POSTGRES_PASSWORD=change_me_postgres_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5433

# ==============================================================================
# Snowflake Data Warehouse Configuration
# ==============================================================================
# Format: <org>-<account> or <locator>.<region> (e.g. xy12345.eu-central-1)
SNOWFLAKE_ACCOUNT=your_snowflake_account_identifier
SNOWFLAKE_USER=your_snowflake_username
SNOWFLAKE_PASSWORD=your_snowflake_password
SNOWFLAKE_WAREHOUSE=COMPUTE_WH
SNOWFLAKE_DATABASE=ECOMMERCE_DB
SNOWFLAKE_SCHEMA=BRONZE
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_AUTHENTICATOR=snowflake

# ==============================================================================
# Apache Airflow Configuration
# ==============================================================================
AIRFLOW_DB_NAME=airflow
AIRFLOW_DB_USER=airflow
AIRFLOW_DB_PASSWORD=change_me_airflow_db_password

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
AIRFLOW_FERNET_KEY=your_generated_fernet_key

# Generate with: python -c "import secrets; print(secrets.token_hex(16))"
AIRFLOW_API_SECRET_KEY=your_generated_api_secret_key

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AIRFLOW_JWT_SECRET=your_generated_jwt_secret

# Airflow container user ID (default 50000)
AIRFLOW_UID=50000
